<%# Temporary geometry/poses: upstream interaction, never editorial saves. %>
<div class="<%= 'cosmosys-cad-observer' if local_assigns[:presentation_only] %>">
<%= render partial: 'cad_previews/viewer', locals: {
  attachment: @attachment, cad_format: @cad_format, cad_image: @cad_image,
  snapshot: false, view: nil, embedded: !!local_assigns[:presentation_only], height: nil, readonly: true
} %>
</div>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'observer', plugin: 'cosmosys_cad_preview' if local_assigns[:presentation_only] %>
  <%= stylesheet_link_tag 'cad_preview', plugin: 'redmine_cad_preview' %>
  <%= javascript_include_tag 'cad_preview', plugin: 'redmine_cad_preview', type: 'module' %>
<% end %>
